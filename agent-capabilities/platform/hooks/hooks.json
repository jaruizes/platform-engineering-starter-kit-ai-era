{
  "description": "Infrastructure changes go through the Golden Paths, not through the agent's shell.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/use-golden-paths.sh\""
          }
        ]
      }
    ]
  }
}
