# Versions used by the local setup. Bump them here, or override any of
# them with an environment variable of the same name.
: "${K3S_IMAGE:=rancher/k3s:v1.34.9-k3s1}"
: "${CROSSPLANE_VERSION:=2.4.2}"
: "${KYVERNO_CHART_VERSION:=3.9.1}"
: "${FUNCTION_GO_TEMPLATING_VERSION:=v0.13.1}"
# Command-line tools used to check platform capabilities (capabilities/tools/check.sh).
: "${CROSSPLANE_CLI_VERSION:=v2.4.1}"
: "${KYVERNO_CLI_VERSION:=v1.19.1}"
