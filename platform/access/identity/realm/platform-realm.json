{
  "realm": "platform",
  "displayName": "Internal Developer Platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 86400,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "roles": {
    "realm": [
      {
        "name": "developer",
        "description": "Member of a team: requests and reads what belongs to their teams"
      },
      {
        "name": "approver",
        "description": "Approves requests of their teams (platform-team: of every team)"
      }
    ]
  },
  "groups": [
    {
      "name": "checkout",
      "path": "/checkout"
    },
    {
      "name": "payments",
      "path": "/payments"
    },
    {
      "name": "platform-team",
      "path": "/platform-team"
    }
  ],
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "García",
      "email": "ana@starterkit.local",
      "groups": [
        "/platform-team"
      ],
      "realmRoles": [
        "developer",
        "approver"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "marta",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Marta",
      "lastName": "López",
      "email": "marta@starterkit.local",
      "groups": [
        "/checkout"
      ],
      "realmRoles": [
        "developer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "luis",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Luis",
      "lastName": "Martín",
      "email": "luis@starterkit.local",
      "groups": [
        "/payments"
      ],
      "realmRoles": [
        "developer",
        "approver"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-ci-agent",
      "enabled": true,
      "serviceAccountClientId": "ci-agent",
      "realmRoles": [
        "developer"
      ]
    },
    {
      "username": "service-account-capability-tests",
      "enabled": true,
      "serviceAccountClientId": "capability-tests",
      "realmRoles": [
        "developer"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "claude-code",
      "name": "Claude Code",
      "description": "AI agent: Claude Code, on behalf of the person who signs in",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:33418/callback",
        "http://127.0.0.1:33418/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "platform audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "platform",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "teams",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client kind",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "client_kind",
            "claim.value": "agent",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "gemini-cli",
      "name": "Gemini CLI",
      "description": "AI agent: Gemini CLI, on behalf of the person who signs in",
      "enabled": true,
